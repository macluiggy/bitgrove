{
  "name": "bitgrove",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bitgrove": "dist/bitgrove.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun build src/cli/main.ts --target=node --format=esm --outfile=dist/bitgrove.mjs",
    "e2e": "bun run build && bun test test/e2e",
    "check": "bun run lint && bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
