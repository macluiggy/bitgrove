{
  "name": "bitgrove",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bitgrove": "dist/bitgrove.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "vite build --config web/vite.config.ts --logLevel warn && bun build src/cli/main.ts --target=node --format=esm --outfile=dist/bitgrove.mjs",
    "e2e": "bun run build && bun test test/e2e",
    "check": "bun run lint && bun run typecheck && bun run build && bun test",
    "dev:web": "vite --config web/vite.config.ts",
    "release:patch": "sh scripts/release.sh patch",
    "release:minor": "sh scripts/release.sh minor",
    "release:major": "sh scripts/release.sh major"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.4",
    "preact": "^11.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
